# Non-secret settings for the Windows loopback connector.
# Copy to config/windows.env. Do not put the Bridge IMAP password or the
# endpoint bearer token in this file. Those live in Windows Credential Manager.
#
# This full-tool block makes all 32 tools listable. It is not approval to
# send, move, delete, or otherwise change mail. The assistant still has to ask.

BIND_HOST=127.0.0.1
BIND_PORT=8765
NODE_BIN=C:\Program Files\nodejs
MCP_JS=C:\Users\YOU\AppData\Local\proton-mail-mcp\build\index.js
PROTONMAIL_USERNAME=REPLACE_WITH_PROTON_ACCOUNT_USERNAME
READONLY=false
PROTONMAIL_ALLOW_SEND=true
PROTONMAIL_ALLOWED_ACTIONS=send_email,reply_email,reply_all_email,forward_email,save_draft,move_message,delete_message,update_message_flags,mark_all_read,bulk_move,bulk_delete,bulk_update_flags,create_folder,create_label,rename_folder,delete_folder,update_message_labels,bulk_update_labels,empty_folder,move_thread,delete_thread,flag_thread
PROTONMAIL_ALLOWED_FOLDERS=*
ALLOW_EMPTY_FOLDER=true
RESTRICT_OUTBOUND_TO_SELF=false
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURE=false
PROTONMAIL_HOST=127.0.0.1
PROTONMAIL_PORT=1025
PROTONMAIL_SECURE=false
ALLOW_FILE_DOWNLOAD_DIR=C:\Users\YOU\AppData\Local\proton-mcp-attachments
# Later, only if Tailscale Serve preserves a non-loopback Host header:
# PROTON_MCP_EXTRA_HOSTS=your-pc.your-tailnet.ts.net:443
