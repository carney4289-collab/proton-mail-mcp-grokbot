# Non-secret settings for the macOS loopback connector.
# scripts/macos/install.sh writes config/macos.env from this file.
# Do not put the Bridge password or the endpoint bearer token here.
# Those live in the macOS login keychain.
#
# The connector process still starts from the no-mutation defaults when
# these lines are absent. This file turns on the full 32-tool list on
# purpose, the same as config/windows.env.example. Listing a tool is not
# approval to send, move, delete, or otherwise change mail.

BIND_HOST=127.0.0.1
BIND_PORT=8765
NODE_BIN=REPLACE_NODE_BIN
MCP_JS=REPLACE_MCP_JS
PROTONMAIL_USERNAME=REPLACE_WITH_PROTON_ACCOUNT_USERNAME
READONLY=false
PROTONMAIL_ALLOW_SEND=true
PROTONMAIL_ALLOWED_ACTIONS=send_email,reply_email,reply_all_email,forward_email,save_draft,move_message,delete_message,update_message_flags,mark_all_read,bulk_move,bulk_delete,bulk_update_flags,create_folder,create_label,rename_folder,delete_folder,update_message_labels,bulk_update_labels,empty_folder,move_thread,delete_thread,flag_thread
PROTONMAIL_ALLOWED_FOLDERS=*
ALLOW_EMPTY_FOLDER=true
RESTRICT_OUTBOUND_TO_SELF=false
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURE=false
PROTONMAIL_HOST=127.0.0.1
PROTONMAIL_PORT=1025
PROTONMAIL_SECURE=false
ALLOW_FILE_DOWNLOAD_DIR=REPLACE_ATTACHMENTS
PROTON_MCP_EXTRA_HOSTS=seans-mac-mini.tail545f1e.ts.net,seans-mac-mini.tail545f1e.ts.net:443
